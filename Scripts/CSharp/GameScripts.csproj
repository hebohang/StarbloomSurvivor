<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <HEngineRoot Condition="'$(HEngineRoot)' == ''">$(HE_ENGINE_ROOT)</HEngineRoot>
  </PropertyGroup>
  <Import Project="$(HEngineRoot)/Engine/Managed/Platform.props" />
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <RuntimeFrameworkVersion>10.0.10</RuntimeFrameworkVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <Deterministic>true</Deterministic>
  </PropertyGroup>
  <ItemGroup><ProjectReference Include="$(HEngineRoot)/Engine/Managed/HEngine.ScriptCore/HEngine.ScriptCore.csproj" /></ItemGroup>
  <ItemGroup Condition="'$(HEPlatform)' != 'Windows'"><Compile Remove="ScriptWorkflowSample.cs" /></ItemGroup>
  <Target Name="ExportGameplayCatalog" BeforeTargets="PrepareForBuild">
    <Exec Command="node &quot;$(HEngineRoot)/Tools/Build/CompileSharedUI.cjs&quot; &quot;$(MSBuildProjectDirectory)/../..&quot;" />
    <Exec Command="node &quot;$(MSBuildProjectDirectory)/../../Tools/ExportContent.cjs&quot; --engine &quot;$(HEngineRoot)&quot; --catalog-only --output &quot;$(IntermediateOutputPath)Content&quot;" />
    <ItemGroup>
      <EmbeddedResource Include="$(IntermediateOutputPath)Content/catalog.json" LogicalName="Survivor.catalog.json" />
      <Compile Include="$(IntermediateOutputPath)Content/SurvivorNativeDependencies.cs" />
    </ItemGroup>
  </Target>
</Project>
