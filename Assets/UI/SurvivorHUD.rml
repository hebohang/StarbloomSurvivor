      <div id="loading_panel" class="modal loading_modal">
        <div id="loading_card" class="modal_card loading_card">
          <div id="loading_emblem">
            <lottie id="loading_lottie" src="Assets/UI/Motion/starbloom-burst.lottie.json"></lottie>
            <img src="Assets/UI/Icons/Survivor/Weapons/starfall.png" />
          </div>
          <div id="loading_eyebrow">星光正在集结</div>
          <div id="loading_title">准备软绵绵的冒险</div>
          <div id="loading_subtitle">魔法背包正在把可爱伙伴和闪亮礼物装进今晚的旅程。</div>
          <div id="loading_progress_shell">
            <div id="loading_progress_fill">
              <div id="loading_progress_glow"></div>
            </div>
          </div>
          <div id="loading_status_row">
            <span id="loading_status">正在唤醒魔法特效</span>
            <span id="loading_percent">0%</span>
          </div>
          <div id="loading_hint">星光铺好道路后，冒险会自动开始。</div>
        </div>
      </div>

      <div id="pause_panel" class="modal">
        <div id="pause_card" class="modal_card pause_card">
          <div class="pause_icon"><img src="Assets/UI/Icons/Survivor/Tomes/haste.png" /></div>
          <div id="pause_title" class="modal_title">休息一下</div>
          <div id="pause_subtitle" class="modal_subtitle">冒险已经暂停，准备好再继续吧。</div>
          <div class="menu_stack pause_menu_stack">
            <button id="resume_button" class="menu_button primary_button"><span id="resume_button_label" class="flex_text">继续冒险</span></button>
            <button id="pause_settings_button" class="menu_button secondary_button"><span id="pause_settings_button_label" class="flex_text">设置</span></button>
            <button id="pause_restart_button" class="menu_button soft_coral_button"><span id="pause_restart_button_label" class="flex_text">重新开始</span></button>
            <button id="pause_home_button" class="menu_button ghost_button"><span id="pause_home_button_label" class="flex_text">返回开始界面</span></button>
          </div>
          <div id="pause_hint" class="modal_hint"><span class="keycap light">ESC</span> <span id="pause_hint_text">返回游戏</span></div>
        </div>
      </div>

      <div id="settings_panel" class="modal">
        <div id="settings_card" class="modal_card settings_card">
          <div id="settings_header">
            <div>
              <div id="settings_eyebrow">舒适小屋</div>
              <div id="settings_title" class="modal_title">设置</div>
            </div>
            <button id="settings_back_button" class="back_button"><span id="settings_back_button_label" class="flex_text">返回</span></button>
          </div>

          <div id="settings_body">
            <div class="setting_row">
              <div class="setting_copy"><span id="settings_language_label" class="setting_label">语言</span><span id="settings_language_desc" class="setting_desc">选择冒险中的文字语言</span></div>
              <div class="segment_group language_segments"><button id="language_zh" class="segment_button"><span id="language_zh_label" class="flex_text">中文</span></button><button id="language_en" class="segment_button"><span id="language_en_label" class="flex_text">英文</span></button></div>
            </div>

            <div class="setting_row">
              <div class="setting_copy"><span id="settings_volume_label" class="setting_label">主音量</span><span id="settings_volume_desc" class="setting_desc">控制所有游戏声音</span></div>
              <div class="stepper"><button id="volume_down" class="stepper_button"><span class="flex_text">−</span></button><span id="volume_value"><span id="volume_value_label" class="flex_text">80%</span></span><button id="volume_up" class="stepper_button"><span class="flex_text">＋</span></button></div>
            </div>

            <div class="setting_row">
              <div class="setting_copy"><span id="settings_vsync_label" class="setting_label">垂直同步</span><span id="settings_vsync_desc" class="setting_desc">减少画面撕裂</span></div>
              <div class="segment_group"><button id="vsync_on" class="segment_button"><span id="vsync_on_label" class="flex_text">开启</span></button><button id="vsync_off" class="segment_button"><span id="vsync_off_label" class="flex_text">关闭</span></button></div>
            </div>

            <div class="setting_row">
              <div class="setting_copy"><span id="settings_display_mode_label" class="setting_label">显示模式</span><span id="settings_display_mode_desc" class="setting_desc">选择全屏游玩或使用窗口</span></div>
              <div class="segment_group display_segments"><button id="display_fullscreen" class="segment_button"><span id="display_fullscreen_label" class="flex_text">全屏</span></button><button id="display_windowed" class="segment_button"><span id="display_windowed_label" class="flex_text">窗口化</span></button></div>
            </div>

            <div class="setting_row">
              <div class="setting_copy"><span id="settings_ui_scale_label" class="setting_label">界面大小</span><span id="settings_ui_scale_desc" class="setting_desc">调整所有界面和菜单</span></div>
              <div class="segment_group scale_segments"><button id="ui_scale_small" class="segment_button"><span id="ui_scale_small_label" class="flex_text">小</span></button><button id="ui_scale_normal" class="segment_button"><span id="ui_scale_normal_label" class="flex_text">标准</span></button><button id="ui_scale_large" class="segment_button"><span id="ui_scale_large_label" class="flex_text">大</span></button></div>
            </div>

            <div class="setting_row">
              <div class="setting_copy"><span id="settings_motion_label" class="setting_label">界面动效</span><span id="settings_motion_desc" class="setting_desc">按钮与星星的柔和动画</span></div>
              <div class="segment_group"><button id="motion_on" class="segment_button"><span id="motion_on_label" class="flex_text">开启</span></button><button id="motion_off" class="segment_button"><span id="motion_off_label" class="flex_text">关闭</span></button></div>
            </div>

            <div class="setting_row">
              <div class="setting_copy"><span id="settings_flash_label" class="setting_label">受伤闪光</span><span id="settings_flash_desc" class="setting_desc">受到伤害时显示珊瑚色提示</span></div>
              <div class="segment_group"><button id="flash_on" class="segment_button"><span id="flash_on_label" class="flex_text">开启</span></button><button id="flash_off" class="segment_button"><span id="flash_off_label" class="flex_text">关闭</span></button></div>
            </div>

            <div class="setting_row">
              <div class="setting_copy"><span id="settings_projectile_opacity_label" class="setting_label">玩家弹体透明度</span><span id="settings_projectile_opacity_desc" class="setting_desc">只调节玩家弹体装饰；核心弹体与敌方预警保持清楚</span></div>
              <div class="stepper"><button id="projectile_opacity_down" class="stepper_button"><span class="flex_text">−</span></button><span id="projectile_opacity_value"><span id="projectile_opacity_value_label" class="flex_text">85%</span></span><button id="projectile_opacity_up" class="stepper_button"><span class="flex_text">＋</span></button></div>
            </div>

            <div class="setting_row">
              <div class="setting_copy"><span id="settings_particle_density_label" class="setting_label">粒子密度</span><span id="settings_particle_density_desc" class="setting_desc">关键命中、弹体核心与预警不会被隐藏</span></div>
              <div class="segment_group four_segments"><button id="particle_density_auto" class="segment_button"><span id="particle_density_auto_label" class="flex_text">自动</span></button><button id="particle_density_low" class="segment_button"><span id="particle_density_low_label" class="flex_text">低</span></button><button id="particle_density_medium" class="segment_button"><span id="particle_density_medium_label" class="flex_text">中</span></button><button id="particle_density_high" class="segment_button"><span id="particle_density_high_label" class="flex_text">高</span></button></div>
            </div>

            <div class="setting_row">
              <div class="setting_copy"><span id="settings_damage_numbers_label" class="setting_label">伤害数字</span><span id="settings_damage_numbers_desc" class="setting_desc">减少高压战斗中的非关键视觉噪声</span></div>
              <div class="segment_group three_segments"><button id="damage_numbers_off" class="segment_button"><span id="damage_numbers_off_label" class="flex_text">关闭</span></button><button id="damage_numbers_reduced" class="segment_button"><span id="damage_numbers_reduced_label" class="flex_text">精简</span></button><button id="damage_numbers_full" class="segment_button"><span id="damage_numbers_full_label" class="flex_text">完整</span></button></div>
            </div>

            <div class="setting_row">
              <div class="setting_copy"><span id="settings_screen_shake_label" class="setting_label">屏幕震动</span><span id="settings_screen_shake_desc" class="setting_desc">关闭后保留伤害方向与危险边界提示</span></div>
              <div class="segment_group"><button id="screen_shake_on" class="segment_button"><span id="screen_shake_on_label" class="flex_text">开启</span></button><button id="screen_shake_off" class="segment_button"><span id="screen_shake_off_label" class="flex_text">关闭</span></button></div>
            </div>

            <div class="setting_row telegraph_setting_row">
              <div class="setting_copy"><span id="settings_telegraph_color_label" class="setting_label">敌方预警颜色</span><span id="settings_telegraph_color_desc" class="setting_desc">选择高对比或色觉辅助预设</span></div>
              <div class="segment_group four_segments"><button id="telegraph_color_default" class="segment_button"><span id="telegraph_color_default_label" class="flex_text">默认</span></button><button id="telegraph_color_deuteranopia" class="segment_button"><span id="telegraph_color_deuteranopia_label" class="flex_text">红绿色弱</span></button><button id="telegraph_color_tritanopia" class="segment_button"><span id="telegraph_color_tritanopia_label" class="flex_text">蓝黄色弱</span></button><button id="telegraph_color_high_contrast" class="segment_button"><span id="telegraph_color_high_contrast_label" class="flex_text">高对比</span></button></div>
            </div>

            <div class="setting_row">
              <div class="setting_copy"><span id="settings_auto_throttle_label" class="setting_label">自动视觉降档</span><span id="settings_auto_throttle_desc" class="setting_desc">高负载时优先降低尾迹与装饰，不隐藏玩法关键视觉</span></div>
              <div class="segment_group"><button id="auto_throttle_on" class="segment_button"><span id="auto_throttle_on_label" class="flex_text">开启</span></button><button id="auto_throttle_off" class="segment_button"><span id="auto_throttle_off_label" class="flex_text">关闭</span></button></div>
            </div>
          </div>

          <div id="settings_footer"><button id="settings_defaults_button" class="small_secondary_button"><span id="settings_defaults_button_label" class="flex_text">恢复默认</span></button><span id="settings_saved_hint">更改会自动保存</span></div>
        </div>
      </div>

      <div id="game_over_panel" class="modal">
        <div id="game_over_card" class="modal_card game_over_card">
          <div id="result_header">
            <div id="game_over_icon"><img src="Assets/UI/Icons/Survivor/Weapons/starfall.png" /></div>
            <div id="result_title_copy"><span id="result_end_reason" class="result_reason">结束原因：失败</span><div id="game_over_title" class="modal_title coral_text">这次冒险结束啦</div><div id="game_over_subtitle" class="modal_subtitle">奖励已提交并保存后，结算操作才会开放。</div></div>
            <div id="result_commit_status" class="result_commit_pending"><span id="result_commit_status_label">正在保存奖励</span><button id="result_commit_retry_button" class="hub_small_button"><span id="result_commit_retry_button_label">重试</span></button></div>
          </div>
          <div id="result_scroll">
            <div id="result_stats">
              <div class="result_stat time_result"><span id="final_time_label" class="result_label">存活时间</span><span id="final_time_value" class="result_value">00:00</span></div>
              <div class="result_stat kill_result"><span id="final_kills_label" class="result_label">击杀</span><span id="final_kills_value" class="result_value">0</span></div>
              <div class="result_stat elite_result"><span id="final_elites_label" class="result_label">精英</span><span id="final_elites_value" class="result_value">0</span></div>
              <div class="result_stat boss_result"><span id="final_bosses_label" class="result_label">首领</span><span id="final_bosses_value" class="result_value">0</span></div>
              <div class="result_stat level_result"><span id="final_level_label" class="result_label">等级</span><span id="final_level_value" class="result_value">1</span></div>
              <div class="result_stat score_result"><span id="final_score_label" class="result_label">得分</span><span id="final_score_value" class="result_value">0</span></div>
            </div>
            <div id="result_columns">
              <div class="result_column">
                <div class="result_section"><div class="result_section_header"><span id="result_gold_section_label">金币结算</span><span id="result_gold_total">0</span></div><div class="formula_row"><span id="result_gold_time_label">存活时间</span><span id="result_gold_time">+0</span></div><div class="formula_row"><span id="result_gold_kills_label">击杀</span><span id="result_gold_kills">+0</span></div><div class="formula_row"><span id="result_gold_elite_boss_label">精英与首领</span><span id="result_gold_elite_boss">+0</span></div><div class="formula_row"><span id="result_gold_clear_difficulty_label">通关与难度</span><span id="result_gold_clear_difficulty">×1.00</span></div><div class="formula_row"><span id="result_weapon_slot_limit_label">普通武器槽</span><span id="result_weapon_slot_limit">3</span></div><div class="formula_row"><span id="result_weapon_slot_bonus_label">低槽位奖励</span><span id="result_weapon_slot_bonus">+0 · ×1.00</span></div><div class="formula_row quest_formula"><span id="result_gold_quests_label">任务奖励（不参与倍率）</span><span id="result_gold_quests">+0</span></div></div>
                <div class="result_section"><div class="result_section_header"><span id="result_survival_section_label">生存记录</span></div><div class="formula_row"><span id="result_damage_taken_label">承受伤害</span><span id="result_damage_taken">0</span></div><div class="formula_row"><span id="result_damage_prevented_label">阻止伤害</span><span id="result_damage_prevented">0</span></div><div class="formula_row"><span id="result_healing_label">治疗</span><span id="result_healing">0</span></div><div class="formula_row"><span id="result_distance_moved_label">移动距离</span><span id="result_distance_moved">0 米</span></div></div>
                <div class="result_section"><div class="result_section_header"><span id="result_objective_section_label">四域与终局</span></div><div class="formula_row"><span id="result_region_order_label">区域激活顺序</span><span id="result_region_order">—</span></div><div class="formula_row"><span id="result_region_attempts_label">区域尝试次数</span><span id="result_region_attempts">—</span></div><div class="formula_row"><span id="result_region_exits_label">离圈失败次数</span><span id="result_region_exits">—</span></div><div class="formula_row"><span id="result_domain_summary_label">区域权能贡献</span><span id="result_domain_summary">—</span></div><div class="formula_row"><span id="result_boss_ttk_label">最终首领用时</span><span id="result_boss_ttk">—</span></div></div>
              </div>
              <div class="result_column weapon_result_column">
                <div class="result_section"><div class="result_section_header"><span id="result_weapon_section_label">武器表现</span><span id="result_weapon_columns_label">伤害 / 每秒伤害 / 命中 / 暴击 / 击杀 / 等级</span></div>
                  <div id="result_weapon_header" class="weapon_result_row"><span id="result_weapon_name_label">武器</span><span id="result_weapon_damage_label">伤害</span><span id="result_weapon_dps_label">每秒</span><span id="result_weapon_hits_label">命中</span><span id="result_weapon_crits_label">暴击</span><span id="result_weapon_kills_label">击杀</span><span id="result_weapon_level_label">等级 / 进化</span></div>
                  <div id="result_weapon_slot_0" class="weapon_result_row"><span id="result_weapon_slot_0_name">—</span><span id="result_weapon_slot_0_damage">0</span><span id="result_weapon_slot_0_dps">0</span><span id="result_weapon_slot_0_hits">0</span><span id="result_weapon_slot_0_crits">0</span><span id="result_weapon_slot_0_kills">0</span><span id="result_weapon_slot_0_level">—</span></div>
                  <div id="result_weapon_slot_1" class="weapon_result_row"><span id="result_weapon_slot_1_name">—</span><span id="result_weapon_slot_1_damage">0</span><span id="result_weapon_slot_1_dps">0</span><span id="result_weapon_slot_1_hits">0</span><span id="result_weapon_slot_1_crits">0</span><span id="result_weapon_slot_1_kills">0</span><span id="result_weapon_slot_1_level">—</span></div>
                  <div id="result_weapon_slot_2" class="weapon_result_row"><span id="result_weapon_slot_2_name">—</span><span id="result_weapon_slot_2_damage">0</span><span id="result_weapon_slot_2_dps">0</span><span id="result_weapon_slot_2_hits">0</span><span id="result_weapon_slot_2_crits">0</span><span id="result_weapon_slot_2_kills">0</span><span id="result_weapon_slot_2_level">—</span></div>
                  <div id="result_weapon_slot_3" class="weapon_result_row"><span id="result_weapon_slot_3_name">—</span><span id="result_weapon_slot_3_damage">0</span><span id="result_weapon_slot_3_dps">0</span><span id="result_weapon_slot_3_hits">0</span><span id="result_weapon_slot_3_crits">0</span><span id="result_weapon_slot_3_kills">0</span><span id="result_weapon_slot_3_level">—</span></div>
                  <div id="result_weapon_slot_4" class="weapon_result_row"><span id="result_weapon_slot_4_name">—</span><span id="result_weapon_slot_4_damage">0</span><span id="result_weapon_slot_4_dps">0</span><span id="result_weapon_slot_4_hits">0</span><span id="result_weapon_slot_4_crits">0</span><span id="result_weapon_slot_4_kills">0</span><span id="result_weapon_slot_4_level">—</span></div>
                  <div id="result_weapon_slot_5" class="weapon_result_row"><span id="result_weapon_slot_5_name">—</span><span id="result_weapon_slot_5_damage">0</span><span id="result_weapon_slot_5_dps">0</span><span id="result_weapon_slot_5_hits">0</span><span id="result_weapon_slot_5_crits">0</span><span id="result_weapon_slot_5_kills">0</span><span id="result_weapon_slot_5_level">—</span></div>
                </div>
                <div class="result_section"><div class="result_section_header"><span id="result_quests_section_label">任务与新资格</span></div><div id="result_quest_progress">本局没有任务进度</div><div id="result_first_completion">首次通关：—</div><div id="result_new_eligible">新购买资格：—</div></div>
              </div>
            </div>
          </div>
          <div id="result_actions"><button id="restart_button" class="menu_button primary_button result_restart_button"><span id="restart_button_label" class="flex_text">再来一次</span></button><button id="result_adjust_build_button" class="menu_button result_build_button"><span id="result_adjust_build_button_label" class="flex_text">调整构筑</span></button><button id="game_over_home_button" class="menu_button result_home_button"><span id="game_over_home_button_label" class="flex_text">返回开始界面</span></button></div>
          <div id="restart_hint" class="modal_hint"><span class="keycap light">R</span> <span id="restart_hint_text">奖励保存成功后可快速重开</span></div>
        </div>
      </div>
    </div>
  </body>
</rml>
