                    <div class="hub_setting_row"><div class="hub_setting_copy"><span id="hub_flash_label" class="setting_label">受伤闪光</span><span id="hub_flash_desc" class="setting_desc">受到伤害时显示提示</span></div><div class="hub_segment_group"><button id="hub_flash_on" class="hub_segment_button"><span id="hub_flash_on_label">开启</span></button><button id="hub_flash_off" class="hub_segment_button"><span id="hub_flash_off_label">关闭</span></button></div></div>
