              <button id="tracked_quest_slot_0" class="tracked_quest_slot"><span id="tracked_quest_slot_0_name">未追踪任务</span><span id="tracked_quest_slot_0_progress">—</span></button>
              <button id="tracked_quest_slot_1" class="tracked_quest_slot"><span id="tracked_quest_slot_1_name">未追踪任务</span><span id="tracked_quest_slot_1_progress">—</span></button>
              <button id="tracked_quest_slot_2" class="tracked_quest_slot"><span id="tracked_quest_slot_2_name">未追踪任务</span><span id="tracked_quest_slot_2_progress">—</span></button>
              <div id="recent_unlock_panel"><span id="recent_unlock_label" class="hub_field_label">最近解锁</span><span id="recent_unlock_name">还没有新解锁</span><span id="recent_unlock_hint">继续冒险，新的星光会在这里出现。</span></div>
            </div>
