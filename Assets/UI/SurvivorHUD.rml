                    <div class="hub_setting_row"><div class="hub_setting_copy"><span id="hub_particle_density_label" class="setting_label">粒子密度</span><span id="hub_particle_density_desc" class="setting_desc">调节装饰粒子数量</span></div><div class="hub_segment_group four_segments"><button id="hub_particle_density_auto" class="hub_segment_button"><span id="hub_particle_density_auto_label">自动</span></button><button id="hub_particle_density_low" class="hub_segment_button"><span id="hub_particle_density_low_label">低</span></button><button id="hub_particle_density_medium" class="hub_segment_button"><span id="hub_particle_density_medium_label">中</span></button><button id="hub_particle_density_high" class="hub_segment_button"><span id="hub_particle_density_high_label">高</span></button></div></div>
                    <div class="hub_setting_row"><div class="hub_setting_copy"><span id="hub_damage_numbers_label" class="setting_label">伤害数字</span><span id="hub_damage_numbers_desc" class="setting_desc">减少高压战斗的视觉噪声</span></div><div class="hub_segment_group three_segments"><button id="hub_damage_numbers_off" class="hub_segment_button"><span id="hub_damage_numbers_off_label">关闭</span></button><button id="hub_damage_numbers_reduced" class="hub_segment_button"><span id="hub_damage_numbers_reduced_label">精简</span></button><button id="hub_damage_numbers_full" class="hub_segment_button"><span id="hub_damage_numbers_full_label">完整</span></button></div></div>
                    <div class="hub_setting_row"><div class="hub_setting_copy"><span id="hub_screen_shake_label" class="setting_label">屏幕震动</span><span id="hub_screen_shake_desc" class="setting_desc">关闭后仍保留危险方向提示</span></div><div class="hub_segment_group"><button id="hub_screen_shake_on" class="hub_segment_button"><span id="hub_screen_shake_on_label">开启</span></button><button id="hub_screen_shake_off" class="hub_segment_button"><span id="hub_screen_shake_off_label">关闭</span></button></div></div>
                    <div class="hub_setting_row"><div class="hub_setting_copy"><span id="hub_telegraph_color_label" class="setting_label">敌方预警颜色</span><span id="hub_telegraph_color_desc" class="setting_desc">选择高对比或色觉辅助方案</span></div><div class="hub_segment_group four_segments"><button id="hub_telegraph_color_default" class="hub_segment_button"><span id="hub_telegraph_default_label">默认</span></button><button id="hub_telegraph_color_deuteranopia" class="hub_segment_button"><span id="hub_telegraph_deuteranopia_label">红绿色弱</span></button><button id="hub_telegraph_color_tritanopia" class="hub_segment_button"><span id="hub_telegraph_tritanopia_label">蓝黄色弱</span></button><button id="hub_telegraph_color_high_contrast" class="hub_segment_button"><span id="hub_telegraph_high_contrast_label">高对比</span></button></div></div>
                    <div class="hub_setting_row"><div class="hub_setting_copy"><span id="hub_auto_throttle_label" class="setting_label">自动视觉降档</span><span id="hub_auto_throttle_desc" class="setting_desc">高负载时优先减少装饰效果</span></div><div class="hub_segment_group"><button id="hub_auto_throttle_on" class="hub_segment_button"><span id="hub_auto_throttle_on_label">开启</span></button><button id="hub_auto_throttle_off" class="hub_segment_button"><span id="hub_auto_throttle_off_label">关闭</span></button></div></div>
                  </div>
