<rml>
  <head>
    <title>小树保卫者 HUD</title>
    <link type="text/rcss" href="SurvivorHUD.rcss" />
  </head>
  <body>
    <div id="hud">
      <div id="title_backdrop">
        <div id="title_backdrop_image"></div>
        <div id="title_backdrop_tint"></div>
      </div>

      <div id="loading_backdrop">
        <div id="loading_backdrop_tint"></div>
      </div>

      <div id="gameplay_hud">
      <div id="xp_hud">
        <div id="xp_track">
          <div id="xp_fill"></div>
          <div id="xp_sheen"></div>
          <div id="xp_flash"></div>
        </div>
        <div id="xp_label">经验 0 / 12 · 0%</div>
      </div>

      <div id="top_bar">
        <div class="top_chip level_chip"><span class="chip_icon">★</span><span id="level">等级 1</span></div>
        <div id="timer_wrap"><span id="timer_caption">本轮时间</span><span id="timer">00:00</span></div>
        <div class="top_chip kill_chip"><span id="kills">击杀 0</span><span class="chip_icon">★</span></div>
      </div>

      <div id="right_stats">
        <div id="enemy_count_panel" class="counter_pill"><span class="counter_dot coral"></span><span id="enemy_count">附近怪物 0</span></div>
        <div id="shard_count_panel" class="counter_pill"><span class="counter_dot aqua"></span><span id="shard_count">星光碎片 0</span></div>
        <div id="score_panel" class="counter_pill score_pill">
          <span id="score_label">灵魂得分</span>
          <span id="score">000000</span>
        </div>
      </div>

      <div id="region_objective_panel" class="objective_panel dormant">
        <div class="objective_header"><span id="region_objective_title">四域净化</span><span id="region_completed_count">0 / 4</span></div>
        <div class="objective_current_row"><span id="region_current_name">寻找未净化区域</span><span id="region_countdown">60.0</span></div>
        <div id="region_status_instruction">追随区域光柱，进入光圈启动净化</div>
        <div class="objective_progress_track"><div id="region_progress_fill"></div></div>
        <div id="objective_navigation">北 · 星之区域 0m</div>
        <div id="region_seals" class="region_seal_grid">
          <div id="region_seal_star" class="region_seal dormant"><span class="region_glyph">★</span><span id="region_seal_star_name" class="region_name">星</span><span id="region_seal_star_status" class="region_status">沉寂</span><span id="region_seal_star_direction" class="region_direction">北 · 0m</span></div>
          <div id="region_seal_thunder" class="region_seal dormant"><span class="region_glyph">ϟ</span><span id="region_seal_thunder_name" class="region_name">雷</span><span id="region_seal_thunder_status" class="region_status">沉寂</span><span id="region_seal_thunder_direction" class="region_direction">西 · 0m</span></div>
          <div id="region_seal_water" class="region_seal dormant"><span class="region_glyph">≈</span><span id="region_seal_water_name" class="region_name">水</span><span id="region_seal_water_status" class="region_status">沉寂</span><span id="region_seal_water_direction" class="region_direction">南 · 0m</span></div>
          <div id="region_seal_wind" class="region_seal dormant"><span class="region_glyph">↝</span><span id="region_seal_wind_name" class="region_name">风</span><span id="region_seal_wind_status" class="region_status">沉寂</span><span id="region_seal_wind_direction" class="region_direction">东 · 0m</span></div>
        </div>
      </div>

      <div id="domain_power_panel">
        <span id="domain_power_title">区域权能</span>
        <div id="domain_power_star" class="domain_power locked"><img id="domain_power_star_icon" src="Assets/UI/Icons/Survivor/Weapons/starfall.png" /><span id="domain_power_star_cooldown">—</span></div>
        <div id="domain_power_thunder" class="domain_power locked"><img id="domain_power_thunder_icon" src="Assets/UI/Icons/Survivor/Weapons/thunder.png" /><span id="domain_power_thunder_cooldown">—</span></div>
        <div id="domain_power_water" class="domain_power locked"><img id="domain_power_water_icon" src="Assets/UI/Icons/Survivor/Weapons/bubble.png" /><span id="domain_power_water_cooldown">—</span></div>
        <div id="domain_power_wind" class="domain_power locked"><img id="domain_power_wind_icon" src="Assets/UI/Icons/Survivor/Weapons/tornado.png" /><span id="domain_power_wind_cooldown">—</span></div>
      </div>

      <div id="controls"><span class="keycap">WASD</span> <span id="controls_move">移动</span>　<span id="controls_jump_key" class="keycap">空格</span> <span id="controls_jump">跳跃</span>　<span id="controls_camera_key" class="keycap">右键</span> <span id="controls_camera">环绕视角</span>　<span id="controls_auto">自动攻击</span></div>
      <div id="banner">熬过长夜</div>
      <div id="damage_flash"></div>

      <div id="boss_panel">
        <div id="boss_row">
          <span class="boss_crown">◆</span>
          <span id="boss_name">暗夜暴君</span>
          <span id="boss_hp">0</span>
        </div>
        <div id="boss_bar"><div id="boss_fill"></div></div>
      </div>

      <div id="bottom_hud">
        <div id="avatar_badge"><span id="avatar_star">★</span></div>
        <div id="vitality_block">
          <div id="hp_row">
            <span id="hp_label">生命</span>
            <span id="hp_text">100 / 100</span>
          </div>
          <div id="hp_bar"><div id="hp_fill"></div><div id="hp_gloss"></div></div>
        </div>
      </div>

      <div id="weapon_panel">
        <div id="weapon_header"><span id="weapon_title">魔法小背包</span><span class="weapon_sparkle">★</span></div>
        <div id="weapon_slots">
          <div id="weapon_slot_1" class="weapon_stat equipped">
            <span class="weapon_icon"><img id="weapon_icon_1" class="loadout_icon" src="Assets/UI/Icons/Survivor/Weapons/comet.png" /></span>
            <span class="weapon_lock">◆</span>
            <span id="weapon_name_1" class="weapon_name">雷霆</span>
            <span id="weapon_value_1" class="weapon_value">1级</span>
          </div>
          <div id="weapon_slot_2" class="weapon_stat empty"><span class="weapon_icon"><img id="weapon_icon_2" class="loadout_icon" src="Assets/UI/Icons/Survivor/Weapons/ring.png" /></span><span class="weapon_lock">◆</span><span id="weapon_name_2" class="weapon_name"></span><span id="weapon_value_2" class="weapon_value"></span></div>
          <div id="weapon_slot_3" class="weapon_stat empty"><span class="weapon_icon"><img id="weapon_icon_3" class="loadout_icon" src="Assets/UI/Icons/Survivor/Weapons/fireball.png" /></span><span class="weapon_lock">◆</span><span id="weapon_name_3" class="weapon_name"></span><span id="weapon_value_3" class="weapon_value"></span></div>
          <div id="weapon_slot_4" class="weapon_stat locked"><span class="weapon_icon"><img id="weapon_icon_4" class="loadout_icon" src="Assets/UI/Icons/Survivor/Weapons/moonblade.png" /></span><span class="weapon_lock">◆</span><span id="weapon_name_4" class="weapon_name"></span><span id="weapon_value_4" class="weapon_value"></span></div>
          <div id="weapon_slot_5" class="weapon_stat locked"><span class="weapon_icon"><img id="weapon_icon_5" class="loadout_icon" src="Assets/UI/Icons/Survivor/Weapons/bubble.png" /></span><span class="weapon_lock">◆</span><span id="weapon_name_5" class="weapon_name"></span><span id="weapon_value_5" class="weapon_value"></span></div>
          <div id="weapon_slot_6" class="weapon_stat locked"><span class="weapon_icon"><img id="weapon_icon_6" class="loadout_icon" src="Assets/UI/Icons/Survivor/Weapons/aura.png" /></span><span class="weapon_lock">◆</span><span id="weapon_name_6" class="weapon_name"></span><span id="weapon_value_6" class="weapon_value"></span></div>
        </div>
        <div id="tome_header"><span id="tome_title">奇妙绘本</span><span class="tome_sparkle">◆</span></div>
        <div id="tome_slots">
          <div id="tome_slot_1" class="tome_stat empty"><img id="tome_icon_1" class="tome_icon" src="Assets/UI/Icons/Survivor/Tomes/magnet.png" /><span id="tome_value_1" class="tome_value"></span></div>
          <div id="tome_slot_2" class="tome_stat empty"><img id="tome_icon_2" class="tome_icon" src="Assets/UI/Icons/Survivor/Tomes/vitality.png" /><span id="tome_value_2" class="tome_value"></span></div>
          <div id="tome_slot_3" class="tome_stat empty"><img id="tome_icon_3" class="tome_icon" src="Assets/UI/Icons/Survivor/Tomes/guard.png" /><span id="tome_value_3" class="tome_value"></span></div>
          <div id="tome_slot_4" class="tome_stat empty"><img id="tome_icon_4" class="tome_icon" src="Assets/UI/Icons/Survivor/Tomes/might.png" /><span id="tome_value_4" class="tome_value"></span></div>
          <div id="tome_slot_5" class="tome_stat empty"><img id="tome_icon_5" class="tome_icon" src="Assets/UI/Icons/Survivor/Tomes/haste.png" /><span id="tome_value_5" class="tome_value"></span></div>
          <div id="tome_slot_6" class="tome_stat empty"><img id="tome_icon_6" class="tome_icon" src="Assets/UI/Icons/Survivor/Tomes/reach.png" /><span id="tome_value_6" class="tome_value"></span></div>
        </div>
      </div>
      </div>

      <div id="upgrade_panel" class="modal">
        <div id="upgrade_card" class="modal_card upgrade_card">
          <div id="upgrade_intro">
            <div id="level_up_badge"><span class="badge_star">★</span></div>
            <div id="level_up_callout">升级啦！</div>
            <div id="upgrade_title" class="modal_title">等级 2</div>
            <div id="upgrade_subtitle" class="modal_subtitle">挑一个喜欢的能力吧</div>
            <div id="upgrade_flavor">每次成长，都会让冒险轻松一点点。</div>
            <div id="upgrade_level_stamp"><span id="upgrade_level_caption">当前等级</span><span id="upgrade_level_value">02</span></div>
            <div class="intro_sparkle sparkle_a">★</div>
            <div class="intro_sparkle sparkle_b">★</div>
          </div>

          <div id="upgrade_choices">
            <div id="choice_prompt"><span class="prompt_star">★</span><span id="choice_prompt_text">三选一 · 选择一份成长礼物</span></div>

            <button id="upgrade_1" class="upgrade_button">
              <span class="selection_glow"></span>
              <span id="upgrade_icon_1" class="upgrade_icon"><img id="upgrade_icon_image_1" class="upgrade_icon_image" src="Assets/UI/Icons/Survivor/Tomes/magnet.png" /></span>
              <span class="upgrade_copy">
                <span class="upgrade_meta">
                  <span id="upgrade_kind_1" class="upgrade_kind">被动能力</span>
                  <span id="upgrade_rank_1" class="upgrade_rank">永久强化</span>
                  <span id="upgrade_rarity_1" class="upgrade_rarity">常规</span>
                </span>
                <span id="upgrade_name_1" class="upgrade_name">吸吸星光</span>
                <span id="upgrade_desc_1" class="upgrade_desc">更远的星光碎片也会主动飞过来。</span>
                <span id="upgrade_stat_1" class="upgrade_stat">拾取范围 +2.2 米</span>
              </span>
              <span class="selected_tick">✓</span>
            </button>

            <button id="upgrade_2" class="upgrade_button">
              <span class="selection_glow"></span>
              <span id="upgrade_icon_2" class="upgrade_icon"><img id="upgrade_icon_image_2" class="upgrade_icon_image" src="Assets/UI/Icons/Survivor/Tomes/vitality.png" /></span>
              <span class="upgrade_copy">
                <span class="upgrade_meta">
                  <span id="upgrade_kind_2" class="upgrade_kind">被动能力</span>
                  <span id="upgrade_rank_2" class="upgrade_rank">永久强化</span>
                  <span id="upgrade_rarity_2" class="upgrade_rarity">常规</span>
                </span>
                <span id="upgrade_name_2" class="upgrade_name">活力泡泡</span>
                <span id="upgrade_desc_2" class="upgrade_desc">最大生命 +28，并恢复 40 生命</span>
                <span id="upgrade_stat_2" class="upgrade_stat">最大生命 +28 · 恢复 40</span>
              </span>
              <span class="selected_tick">✓</span>
            </button>

            <button id="upgrade_3" class="upgrade_button">
              <span class="selection_glow"></span>
              <span id="upgrade_icon_3" class="upgrade_icon"><img id="upgrade_icon_image_3" class="upgrade_icon_image" src="Assets/UI/Icons/Survivor/Tomes/guard.png" /></span>
              <span class="upgrade_copy">
                <span class="upgrade_meta">
                  <span id="upgrade_kind_3" class="upgrade_kind">被动能力</span>
                  <span id="upgrade_rank_3" class="upgrade_rank">永久强化</span>
                  <span id="upgrade_rarity_3" class="upgrade_rarity">常规</span>
                </span>
                <span id="upgrade_name_3" class="upgrade_name">软绵护甲</span>
                <span id="upgrade_desc_3" class="upgrade_desc">受到的伤害降低 10%</span>
                <span id="upgrade_stat_3" class="upgrade_stat">伤害减免 +10%</span>
              </span>
              <span class="selected_tick">✓</span>
            </button>

            <div id="upgrade_pool_controls">
              <button id="upgrade_reroll_button" class="upgrade_control_button"><span id="upgrade_reroll_label">重抽 · 0</span></button>
              <button id="upgrade_skip_button" class="upgrade_control_button"><span id="upgrade_skip_label">跳过 · 0</span></button>
              <button id="upgrade_banish_button" class="upgrade_control_button"><span id="upgrade_banish_label">放逐所选 · 0</span></button>
            </div>
            <div id="upgrade_hint" class="modal_hint"><span class="mouse_badge"><img class="hint_cursor_icon" src="Assets/UI/Cursors/starbloom_cursor.png" /></span><span id="upgrade_hint_mouse">移动鼠标选择，点击卡片确认</span></div>
          </div>
        </div>
      </div>

      <div id="start_panel" class="modal start_modal">
        <div id="start_sparkle_a" class="menu_sparkle start_sparkle_a"></div>
        <div id="start_sparkle_b" class="menu_sparkle start_sparkle_b"></div>
        <div id="start_sparkle_c" class="menu_sparkle start_sparkle_c"></div>
        <div id="start_card" class="modal_card start_card hub_shell">
          <svg id="start_starburst" src="Assets/UI/Motion/starbloom-starburst.svg"></svg>
          <div id="start_card_aura_top" class="start_card_aura"></div>
          <div id="start_card_aura_bottom" class="start_card_aura"></div>
          <div id="hub_topbar">
            <div id="hub_brand">
              <div id="start_emblem"><img src="Assets/UI/Icons/Survivor/Weapons/starfall.png" /></div>
              <div id="hub_brand_copy">
                <div id="start_eyebrow">软绵绵的星光冒险</div>
                <div id="start_title">小树保卫者</div>
              </div>
            </div>
            <div id="hub_status_strip">
              <div id="hub_wallet" class="hub_status_chip"><span id="hub_wallet_label" class="hub_chip_label">星币</span><span id="hub_wallet_value" class="hub_chip_value">0</span></div>
              <div id="hub_completion" class="hub_status_chip"><span id="hub_completion_label" class="hub_chip_label">完成度</span><span id="hub_completion_value" class="hub_chip_value">0%</span></div>
              <div id="hub_difficulty" class="hub_status_chip difficulty_status"><span id="hub_difficulty_label" class="hub_chip_label">当前难度</span><span id="hub_difficulty_value" class="hub_chip_value">冒险</span></div>
            </div>
          </div>

          <div id="hub_body">
            <div id="hub_navigation">
              <button id="hub_nav_play" class="hub_nav_button"><span class="hub_nav_icon">▶</span><span class="hub_nav_copy"><span id="hub_nav_play_label">开始冒险</span></span></button>
              <button id="hub_nav_characters" class="hub_nav_button"><span class="hub_nav_icon">★</span><span class="hub_nav_copy"><span id="hub_nav_characters_label">伙伴</span></span></button>
              <button id="hub_nav_armory" class="hub_nav_button"><span class="hub_nav_icon">◆</span><span class="hub_nav_copy"><span id="hub_nav_armory_label">军械库</span></span></button>
              <button id="hub_nav_shop" class="hub_nav_button"><span class="hub_nav_icon">＋</span><span class="hub_nav_copy"><span id="hub_nav_shop_label">星光成长</span></span></button>
              <button id="hub_nav_quests" class="hub_nav_button"><span class="hub_nav_icon">✓</span><span class="hub_nav_copy"><span id="hub_nav_quests_label">星愿任务</span></span></button>
              <button id="hub_nav_collection" class="hub_nav_button"><span class="hub_nav_icon">◇</span><span class="hub_nav_copy"><span id="hub_nav_collection_label">图鉴统计</span></span></button>
              <button id="hub_nav_settings" class="hub_nav_button"><span class="hub_nav_icon">⚙</span><span class="hub_nav_copy"><span id="hub_nav_settings_label">设置</span></span></button>
            </div>

            <div id="hub_workspace">
              <div id="hub_page_play" class="hub_page selected_hub_page">
                <div class="hub_page_header">
                  <div><span id="play_page_eyebrow" class="hub_page_eyebrow">开始冒险</span><span id="play_page_title" class="hub_page_title">今晚的星光旅程</span></div>
                  <span id="play_reward_multiplier" class="reward_multiplier">奖励 ×1.00</span>
                </div>
                <div id="play_scroll" class="hub_page_scroll">
                  <div id="play_hero_card" class="hub_feature_card">
                    <img id="play_character_portrait" class="play_portrait" src="Assets/UI/Icons/Survivor/Characters/starpaw.png" />
                    <div class="play_character_copy">
                      <span id="play_character_label" class="hub_field_label">当前伙伴</span>
                      <span id="play_character_name" class="play_character_name">—</span>
                      <span id="play_character_passive" class="hub_body_copy">从伙伴页确认后，本局模型、被动与起始武器会使用同一快照。</span>
                    </div>
                    <button id="play_change_character_button" class="hub_small_button"><span id="play_change_character_label" class="flex_text">更换伙伴</span></button>
                  </div>
                  <div class="hub_section">
                    <span id="play_difficulty_label" class="hub_section_title">难度</span>
                    <div id="difficulty_choices" class="choice_row">
                      <button id="difficulty_adventure" class="choice_card"><span id="difficulty_adventure_title" class="choice_title">冒险</span><span id="difficulty_adventure_subtitle" class="choice_subtitle">奖励 ×1.00</span></button>
                      <button id="difficulty_fierce" class="choice_card"><span id="difficulty_fierce_title" class="choice_title">凶猛</span><span id="difficulty_fierce_subtitle" class="choice_subtitle">奖励 ×1.35</span></button>
                      <button id="difficulty_nightmare" class="choice_card locked_content"><span id="difficulty_nightmare_title" class="choice_title">噩梦</span><span id="difficulty_nightmare_subtitle" class="choice_subtitle">未解锁 · 奖励 ×1.75</span></button>
                    </div>
                  </div>
                  <div class="hub_section">
                    <div class="section_heading_row"><span id="play_weapon_slots_label" class="hub_section_title">普通武器槽位</span><span id="play_weapon_slots_summary" class="section_counter">已购上限 3 槽 · 本局计划 3 槽</span></div>
                    <div id="weapon_limit_choices" class="choice_row weapon_limit_choices">
                      <button id="weapon_limit_3" class="choice_card"><span id="weapon_limit_3_label" class="choice_title">3 槽 · 结算金币 +20%</span></button>
                      <button id="weapon_limit_4" class="choice_card locked_content"><span id="weapon_limit_4_label" class="choice_title">4 槽 · 需要冒险首通</span></button>
                      <button id="weapon_limit_5" class="choice_card locked_content"><span id="weapon_limit_5_label" class="choice_title">5 槽 · 需要凶猛首通</span></button>
                      <button id="weapon_limit_6" class="choice_card locked_content"><span id="weapon_limit_6_label" class="choice_title">6 槽 · 需要噩梦首通</span></button>
                    </div>
                  </div>
                  <div class="hub_section">
                    <div class="section_heading_row"><span id="play_challenges_label" class="hub_section_title">挑战</span><span id="play_challenge_count" class="section_counter">0 / 6</span></div>
                    <div id="challenge_choices" class="toggle_grid">
                      <button id="challenge_slot_0" class="toggle_card"><span id="challenge_slot_0_mark" class="toggle_mark">＋</span><span id="challenge_slot_0_name">挑战槽 1</span></button>
                      <button id="challenge_slot_1" class="toggle_card"><span id="challenge_slot_1_mark" class="toggle_mark">＋</span><span id="challenge_slot_1_name">挑战槽 2</span></button>
                      <button id="challenge_slot_2" class="toggle_card"><span id="challenge_slot_2_mark" class="toggle_mark">＋</span><span id="challenge_slot_2_name">挑战槽 3</span></button>
                      <button id="challenge_slot_3" class="toggle_card"><span id="challenge_slot_3_mark" class="toggle_mark">＋</span><span id="challenge_slot_3_name">挑战槽 4</span></button>
                      <button id="challenge_slot_4" class="toggle_card"><span id="challenge_slot_4_mark" class="toggle_mark">＋</span><span id="challenge_slot_4_name">挑战槽 5</span></button>
                      <button id="challenge_slot_5" class="toggle_card"><span id="challenge_slot_5_mark" class="toggle_mark">＋</span><span id="challenge_slot_5_name">挑战槽 6</span></button>
                    </div>
                  </div>
                  <div id="play_seed_row" class="hub_inline_card"><span><span id="play_seed_label" class="hub_field_label">本局种子</span><span id="play_seed_value" class="hub_inline_value">7319</span></span><button id="play_seed_button" class="hub_small_button action_button"><span id="play_seed_button_label" class="flex_text">重新生成</span></button></div>
                  <div id="start_features">
                    <span id="start_feature_magic" class="feature_chip aqua_chip"><span id="start_feature_magic_label" class="flex_text">自动魔法</span></span>
                    <span id="start_feature_cozy" class="feature_chip coral_chip"><span id="start_feature_cozy_label" class="flex_text">可爱怪潮</span></span>
                    <span id="start_feature_growth" class="feature_chip yellow_chip"><span id="start_feature_growth_label" class="flex_text">每局新成长</span></span>
                  </div>
                  <div class="menu_stack start_menu_stack">
                    <button id="start_button" class="menu_button primary_button"><span id="start_button_label" class="flex_text">开始冒险</span></button>
                  </div>
