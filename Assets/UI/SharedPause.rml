<rml><head><title>SharedPause</title></head><body style="margin:0px;padding:0px;width:100%;height:100%;overflow:hidden;"><div id="shared_pause" style="position:absolute;box-sizing:border-box;overflow:hidden;margin:0dp;padding:0dp;background-color:#0a1423aa;color:#ffffffff;font-size:24dp;border-radius:0dp;border:0dp #00000000;pointer-events:auto;left:0dp;top:0dp;width:100%;height:100%;font-family:&#39;Noto Sans SC&#39;;white-space:nowrap"><div id="shared_pause_card" style="position:absolute;box-sizing:border-box;overflow:hidden;margin:0dp;padding:0dp;background-color:#f0f3f5;color:#ffffffff;font-size:24dp;border-radius:12dp;border:0dp #00000000;pointer-events:auto;left:50%;margin-left:-210dp;width:420dp;top:50%;margin-top:-175dp;height:350dp;font-family:&#39;Noto Sans SC&#39;;white-space:nowrap"><p id="shared_pause_title" style="position:absolute;box-sizing:border-box;overflow:hidden;margin:0dp;padding:0dp;background-color:#00000000;color:#29394d;font-size:26dp;border-radius:0dp;border:0dp #00000000;pointer-events:none;left:0%;right:0%;margin-left:24dp;margin-right:24dp;width:auto;top:0%;margin-top:24dp;height:42dp;font-family:&#39;Noto Sans SC&#39;;white-space:nowrap">冒险暂停</p><button id="shared_resume" style="position:absolute;box-sizing:border-box;overflow:hidden;margin:0dp;padding:0dp;background-color:#a8efd6;color:#29394d;font-size:20dp;border-radius:10dp;border:0dp #00000000;pointer-events:auto;left:0%;right:0%;margin-left:24dp;margin-right:24dp;width:auto;top:0%;margin-top:100dp;height:48dp;font-family:&#39;Noto Sans SC&#39;;white-space:nowrap">继续冒险</button><button id="shared_abandon" style="position:absolute;box-sizing:border-box;overflow:hidden;margin:0dp;padding:0dp;background-color:#d9e2ec;color:#29394d;font-size:20dp;border-radius:10dp;border:0dp #00000000;pointer-events:auto;left:0%;right:0%;margin-left:24dp;margin-right:24dp;width:auto;top:0%;margin-top:174dp;height:48dp;font-family:&#39;Noto Sans SC&#39;;white-space:nowrap">结算并离开</button><button id="shared_restart" style="position:absolute;box-sizing:border-box;overflow:hidden;margin:0dp;padding:0dp;background-color:#ffe4a0;color:#29394d;font-size:20dp;border-radius:10dp;border:0dp #00000000;pointer-events:auto;left:0%;right:0%;margin-left:24dp;margin-right:24dp;width:auto;top:0%;margin-top:248dp;height:48dp;font-family:&#39;Noto Sans SC&#39;;white-space:nowrap">重新开始</button></div></div></body></rml>
